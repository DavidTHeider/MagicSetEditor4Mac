pruefe (window.__cjk = (familie) => { const h = document.createElement('h2'); h.textContent = '日本語の見出し中文标题'; h.style.position = 'absolute'; h.style.whiteSpace = 'nowrap'; document.body.appendChild(h); const s = document.createElement('h2'); s.textContent = h.textContent; s.style.cssText = 'position:absolute;white-space:nowrap;font-family:' + familie; document.body.appendChild(s); const w = [h.getBoundingClientRect().width, s.getBoundingClientRect().width]; h.remove(); s.remove(); return w }, true)
