# UX-09 (#1681) — Farbwelten, Fensterbild, Schrift über die ganze Oberfläche und eigene Farben, gesetzt über die Einstellungen und gemessen in WKWebView.
#
# **Gesetzt wie ein Mensch es setzt, gemessen am Element**:
#
# - **AK-01 Farbwelten** — Klar, Schiefer und Moos, je hell und dunkel: jeder
#   sichtbare Text gegen seinen wirksamen Grund, auf zwei Seiten; keiner
#   unter 4,5 : 1.
# - **AK-01 Fensterbild** — das Bild aus dem Prüfbestand (`webkitabnahme.sh`
#   legt es ab, weil ein Dateidialog hier nicht aufgeht): Vorschau, die drei
#   Skalierungen am berechneten Stil, „Aus" und „Bild entfernen".
# - **AK-02 Schrift** — die ganze Oberfläche in einer Textschrift, eine
#   Schmuckschrift bleibt an den Überschriften, und japanische wie chinesische
#   Zeichen fallen auf Hiragino beziehungsweise PingFang/Songti, nicht auf
#   eine beliebige Systemschrift; die Kartenvorschau behält ihre Adresse.
# - **AK-03/04 Eigene Farben** — eine Zeile, die die Form verfehlt, wird an
#   ihrer Stelle genannt; eine unlesbare Farbe wird nicht angewandt; eine
#   lesbare gilt.
#
# **Was es nicht zeigt**: die Menüleiste (Darstellung zurücksetzen gehört
# dem Wails-Prozess, `docs/HANDPRUEFUNGEN.md`) und den Bildpunkt unter dem
# Schleier — dessen Kontrast rechnet `themen.test.ts` für jede Farbwelt.
# **Und ob eine Schrift geladen ist**: `FontFaceSet.check` sagt das für
# eine Systemschrift immer zu (G2 aus dem Zweitblick über Phase 6.3) — der
# Schritt, der danach fragt, kann nicht scheitern. Was am Element gilt,
# misst die berechnete `font-family`.
# **Am Ende wird zurückgesetzt**: die Drehbücher danach laufen auf demselben
# Bestand.
motor wk2
lade /
frist 20000
warte nav
wartetext Erste Schritte
taste escape
pruefe (window.__kontraste = () => { const rgb = (s) => { const m = s.match(/rgba?\(([^)]+)\)/); if (!m) return null; const t = m[1].split(/[ ,\/]+/).filter(Boolean).map(Number); return [t[0], t[1], t[2], t.length > 3 ? t[3] : 1] }; const lin = (c) => { c /= 255; return c <= 0.03928 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4) }; const L = (c) => 0.2126 * lin(c[0]) + 0.7152 * lin(c[1]) + 0.0722 * lin(c[2]); const grund = (e) => { for (let x = e; x; x = x.parentElement) { const b = rgb(getComputedStyle(x).backgroundColor); if (b && b[3] > 0.5) return b } return [255, 255, 255, 1] }; const raus = []; for (const e of document.querySelectorAll('body *')) { if (!e.checkVisibility()) continue; if (![...e.childNodes].some((n) => n.nodeType === 3 && n.textContent.trim().length > 1)) continue; const f = rgb(getComputedStyle(e).color); if (!f) continue; const g = grund(e); const v = f[3] < 1 ? [0, 1, 2].map((i) => f[i] * f[3] + g[i] * (1 - f[3])) : f; const a = L(v), b = L(g); raus.push([Math.round((Math.max(a, b) + 0.05) / (Math.min(a, b) + 0.05) * 100) / 100, e.textContent.trim().slice(0, 30)]) } return raus.sort((x, y) => x[0] - y[0]) }, window.__unter45 = () => window.__kontraste().filter((z) => z[0] < 4.5).map((z) => z[1]).slice(0, 5), window.__waehle = (text, wert) => { const s = [...document.querySelectorAll('select')].find((w) => w.checkVisibility() && w.labels && w.labels[0] && w.labels[0].textContent.includes(text)); if (s) { if (s.value !== wert) { s.value = wert; s.dispatchEvent(new Event('change', { bubbles: true })) } return true } const g = [...document.querySelectorAll('[role=radiogroup]')].find((r) => r.checkVisibility() && document.getElementById(r.getAttribute('aria-labelledby')).textContent.includes(text)); const f = g && [...g.querySelectorAll('input[type=radio]')].find((i) => i.value === wert); if (f && !f.checked) f.click(); return !!f }, window.__gebiet = () => { const b = [...document.querySelectorAll('main button')].find((k) => k.checkVisibility() && k.textContent.startsWith('Erscheinungsbild')); if (b) b.dataset.ziel = 'eb'; return true }, window.__grundbild = () => { const e = [...document.querySelectorAll('.bg-grund')].find((x) => x.checkVisibility()); return e ? getComputedStyle(e) : null }, true)

