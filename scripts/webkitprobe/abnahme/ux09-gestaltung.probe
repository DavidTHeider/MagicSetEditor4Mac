bis document.querySelector('[data-ziel="farbfalte"]').getAttribute('aria-expanded') === 'true'
warte textarea[data-einstellung="gestaltung"]
# **Vor jedem Klick neu markiert**: nach einem geglückten Schreiben baut die Seite das Feld
# neu auf (`key` am gespeicherten Wert, §7 Regel 1), und die alte Marke hängt an einem Knoten,
# den es nicht mehr gibt.
klicke textarea[data-einstellung="gestaltung"]
tippe --mse-grund: #111111;
taste enter
tippe --mse-grund: url(x);
pruefe (document.querySelector('textarea[data-einstellung="gestaltung"]').closest('section').querySelector('button').dataset.ziel = 'uebernehmen', true)
