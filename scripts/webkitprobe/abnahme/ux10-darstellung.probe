# UX-10.AK-03 (#1682) — größere Schrift, hoher Kontrast und weniger Bewegung, gesetzt über die Einstellungen und gemessen in WKWebView.
#
# **Über die Einstellungen und nicht über ein Attribut**: gesetzt wird, wie
# ein Mensch es setzt, und gemessen, was danach am Element ankommt. Je
# Einstellung der Weg und die Wirkung:
#
# - **Hoher Kontrast** — jedes sichtbare Textelement gegen seinen wirksamen
#   Grund, im hellen und im dunklen Bild: keines unter 7 : 1 (WCAG 1.4.6).
# - **Weniger Bewegung** — **das Attribut am Wurzelelement**, nicht die
#   Übergangsdauer, die hier früher stand (G2 aus dem Zweitblick über Phase
#   6.3). Die Oberfläche hat keine Übergänge; ob die Regel einen Übergang
#   tatsächlich kürzt, misst die Hüllenprobe `phase611` am nativen Fenster,
#   mit Gegenprobe ohne die Einstellung.
# - **Sehr große Schrift** — die Wurzelschrift und kein abgeschnittener Knopf
#   auf den Seiten, die ein Weg zuerst trifft (S06.NAT-04 gehört dazu).
#
# **Am Ende wird zurückgesetzt**: die Drehbücher danach laufen auf demselben
# Bestand. **Was es nicht zeigt**: die Systemeinstellungen selbst — die Probe
# kann `prefers-contrast` und `prefers-reduced-motion` nicht setzen; sie
# greifen über dieselben Regeln.
motor wk2
lade /
frist 20000
warte nav
wartetext Erste Schritte
taste escape
pruefe (window.__kontraste = () => { const rgb = (s) => { const m = s.match(/rgba?\(([^)]+)\)/); if (!m) return null; const t = m[1].split(/[ ,\/]+/).filter(Boolean).map(Number); return [t[0], t[1], t[2], t.length > 3 ? t[3] : 1] }; const lin = (c) => { c /= 255; return c <= 0.03928 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4) }; const L = (c) => 0.2126 * lin(c[0]) + 0.7152 * lin(c[1]) + 0.0722 * lin(c[2]); const grund = (e) => { for (let x = e; x; x = x.parentElement) { const b = rgb(getComputedStyle(x).backgroundColor); if (b && b[3] > 0.5) return b } return [255, 255, 255, 1] }; const raus = []; for (const e of document.querySelectorAll('body *')) { if (!e.checkVisibility()) continue; if (![...e.childNodes].some((n) => n.nodeType === 3 && n.textContent.trim().length > 1)) continue; const f = rgb(getComputedStyle(e).color); if (!f) continue; const g = grund(e); const v = f[3] < 1 ? [0, 1, 2].map((i) => f[i] * f[3] + g[i] * (1 - f[3])) : f; const a = L(v), b = L(g); raus.push([Math.round((Math.max(a, b) + 0.05) / (Math.min(a, b) + 0.05) * 100) / 100, e.textContent.trim().slice(0, 30)]) } return raus.sort((x, y) => x[0] - y[0]) }, window.__unter7 = () => window.__kontraste().filter((z) => z[0] < 7).map((z) => z[1]).slice(0, 5), window.__waehle = (text, wert) => { const s = [...document.querySelectorAll('select')].find((w) => w.checkVisibility() && w.labels && w.labels[0] && w.labels[0].textContent.includes(text)); if (s) { if (s.value !== wert) { s.value = wert; s.dispatchEvent(new Event('change', { bubbles: true })) } return true } const g = [...document.querySelectorAll('[role=radiogroup]')].find((r) => r.checkVisibility() && document.getElementById(r.getAttribute('aria-labelledby')).textContent.includes(text)); const f = g && [...g.querySelectorAll('input[type=radio]')].find((i) => i.value === wert); if (f && !f.checked) f.click(); return !!f }, window.__abgeschnitten = () => [...document.querySelectorAll('main button, header button')].filter((b) => b.checkVisibility() && (b.scrollWidth > b.clientWidth + 1 || b.getBoundingClientRect().right > document.documentElement.clientWidth + 1)).map((b) => (b.innerText || b.getAttribute('aria-label') || '').trim().slice(0, 30)), true)
