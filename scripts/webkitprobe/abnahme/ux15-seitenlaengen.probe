# UX-15 (#1771) — jede registrierte Seite am laufenden Fenster: wie lang sie
# ist und was man beim Öffnen sieht. **Gemessen, nicht aus dem Quelltext**:
# das Issue verlangt es so (AGENTS.md §3), und der Wächter über die 140
# Zeichen sieht nur Text.
#
# Je Seite: über die Befehlspalette geöffnet, dann die Überschrift, die Höhe
# des Inhalts bei 1.440 × 900 und der Anteil, der ohne Rollen zu sehen ist,
# dazu ein Abzug. Die Seiten eines Sets erst ohne und dann mit offenem Set.
# **Ob der sichtbare Satz der richtige ist**, beurteilt ein Mensch am Abzug —
# das Ergebnis steht je Seite in `docs/FLAECHENTEXTE.md`.
#
# Gemessen vorher, am 2026-09-24 mit dem echten Paketbestand: die
# Vorlagenwerkstatt 60.317 Punkte hoch (der Baum mit 536 Paketen trug die
# Seite), die Startseite 24.827 (536 Hinweise), und der Kartenarbeitsplatz
# 1.045 Punkte breit — unter der Grenze von 1.072 klappte der Navigator ein,
# und die Kartenliste fehlte bei 1.440 × 900.
motor wk2
lade /
frist 20000
warte nav
wartetext Erste Schritte
taste escape
pause 500

notiz Start
taste cmd+k
warte [role=dialog] input[aria-label="Wohin?"]
pruefe ([...document.querySelectorAll('[role=dialog] button')].find((b) => b.getClientRects().length > 0 && b.innerText.trim() === 'Start').dataset.ziel = 'seite', true)
klicke [role=dialog] [data-ziel="seite"]
bis !document.querySelector('input[aria-label="Wohin?"]')
pause 1200
zeige (() => { const m = document.querySelector('main'); const h = [...m.querySelectorAll('h1')].find((e) => e.getClientRects().length > 0); const s = [...document.querySelectorAll('[role=dialog] h2, [role=dialog] h1')].find((e) => e.getClientRects().length > 0); return (h ? h.textContent.trim() : '—') + (s ? ' · Schublade: ' + s.textContent.trim() : '') + ' · ' + document.scrollingElement.scrollHeight + ' hoch, ' + Math.round(Math.min(1, innerHeight / document.scrollingElement.scrollHeight) * 100) + ' % im ersten Blick' })()
zeige 'lang: ' + JSON.stringify((() => { const beschrieben = new Set([...document.querySelectorAll('[aria-describedby]')].flatMap((e) => e.getAttribute('aria-describedby').split(/\s+/))); return [...document.querySelectorAll('main p, [role=dialog] p')].filter((p) => p.offsetParent !== null && !beschrieben.has(p.id)).map((p) => p.innerText.replace(/\s+/g, ' ').trim()).filter((x) => x.length > 140) })().map((x) => x.slice(0, 60) + '… (' + x.length + ')')) + ' · doppelt: ' + JSON.stringify((() => { const t = [...document.querySelectorAll('main p, [role=dialog] p')].filter((p) => p.offsetParent !== null).map((p) => p.innerText.replace(/\s+/g, ' ').trim()); return t.filter((x, i) => x.length > 30 && t.indexOf(x) !== i) })())
gleich (() => { const beschrieben = new Set([...document.querySelectorAll('[aria-describedby]')].flatMap((e) => e.getAttribute('aria-describedby').split(/\s+/))); return [...document.querySelectorAll('main p, [role=dialog] p')].filter((p) => p.offsetParent !== null && !beschrieben.has(p.id)).map((p) => p.innerText.replace(/\s+/g, ' ').trim()).filter((x) => x.length > 140) })().length => 0
abzug seite-01
notiz Die Startseite zeigt fünf Hinweise und den Rest auf Wunsch
pruefe (() => { const b = document.querySelector('section[aria-label="Was Aufmerksamkeit braucht"]'); if (!b) return true; const knoepfe = b.querySelectorAll('ul > li > button').length; return knoepfe <= 5 })()

