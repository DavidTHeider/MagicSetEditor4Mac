# #1767 — Adresse und Port der zwei Dienste tragen ihren Namen, in WKWebView.
#
# In *Einstellungen › Verbindungen* standen „Adresse" und „Port" je zweimal.
# Die Probe klappt den Kasten für Fachleute auf und liest die Aufschriften
# der vier Felder — und zählt, dass keine Aufschrift zweimal dasteht.
motor wk2
lade /
frist 20000
warte nav
wartetext Erste Schritte
taste escape
taste cmd+,
wartetext Verbindungen
klicke [role=tab][data-lasche="verbindungen"]
wartetext Was Fachleute hier sonst noch einstellen
klicketext Was Fachleute hier sonst noch einstellen
wartetext Adresse der Skriptschnittstelle
zeige [...document.querySelectorAll('[role=tabpanel] label')].filter((l) => l.getClientRects().length > 0 && l.querySelector('input')).map((l) => l.innerText.trim().split('\n')[0]).join(' | ')
gleich ['Adresse der Skriptschnittstelle', 'Port der Skriptschnittstelle', 'Adresse des Werkzeugservers', 'Port des Werkzeugservers'].every((name) => [...document.querySelectorAll('[role=tabpanel] label')].some((l) => l.getClientRects().length > 0 && l.innerText.trim().startsWith(name))) => true
gleich (() => { const namen = [...document.querySelectorAll('[role=tabpanel] input, [role=tabpanel] select, [role=tabpanel] textarea')].filter((e) => e.getClientRects().length > 0).map((e) => e.getAttribute('aria-label') || (e.labels && e.labels[0] ? e.labels[0].innerText.trim().split('\n')[0] : '')).filter((n) => n !== ''); return namen.filter((n, i) => namen.indexOf(n) !== i) })().length => 0
abzug dienstfelder
notiz Und die Seite hat keinen Fehler geworfen
gleich JSON.stringify(window.__probeFehler || []) => []
