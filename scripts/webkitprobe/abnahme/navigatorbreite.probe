zeige [...document.querySelectorAll('aside input, aside select, aside textarea')].map(e => { const a = e.closest('aside').getBoundingClientRect(); const r = e.getBoundingClientRect(); return (e.placeholder || e.name || e.tagName) + ': ' + Math.round(r.right) + ' / ' + Math.round(a.right) })
pruefe [...document.querySelectorAll('aside input, aside select, aside textarea')].every(e => e.getBoundingClientRect().right <= e.closest('aside').getBoundingClientRect().right + 0.5)
