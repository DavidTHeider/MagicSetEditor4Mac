# UX-05 (#1677) — der Assistent für ein neues Set in WKWebView.
#
# S07.NAT-02: die Suche findet einen Stil nach sichtbarem Namen und nach
# technischer Kennung. S07.NAT-03: der Assistent ist überspringbar und behält
# die Eingaben beim Zurückgehen. **Angelegt wird hier nichts** — das tut
# `ux05-erstesset`, und die Abnahmen teilen sich einen Bestand.
#
# **Gegen die eigene Vorrichtung** (`testdaten/assistent/`, WK04 #2105) und
# nicht mehr gegen das persönliche Pack: zwei Spiele — die Saat (`probe`) und
# `wahlspiel` —, also drei Schritte. **Vorgewählt ist, was bei MSE2 zuerst
# steht** — der kleinste `position hint:`: `wahlspiel` (1) und dort
# „Mondlicht" (`wahlspiel-laterne`, 1).
#
# **Gesucht wird ein Stil, dessen Name und Kennung nichts teilen**:
# `wahlspiel-kiesel` heißt „Flusslauf" — „fluss" steht nur im Namen,
# „kiesel" nur in der Kennung. Die Wahl ist eine Suchauswahl; ihre Zeilen
# nennen beides.
motor wk2
lade /
frist 20000
warte nav
wartetext Erste Schritte
taste escape
taste cmd+2
# **Seit dem Umbau der Setseite steht das Anlegen hinter »Neues Set«** —
# die Seite zeigt zuerst die Sets im Bestand.
wartetext Neues Set
klicketext Neues Set
wartetext Ein neues Set
# **»Neues Set« springt seit #2367 gleich zum Namen**, wie ⌘N — der Weg
# zurück zur Art geht über »Zurück«.
bis document.querySelector('ol[aria-label="Schritte zum neuen Set"] li[aria-current="step"]')?.lastChild.textContent === 'Name'
klicketext Zurück
bis document.querySelector('ol[aria-label="Schritte zum neuen Set"] li[aria-current="step"]')?.lastChild.textContent === 'Aussehen'
klicketext Zurück
notiz Vorbedingung: das Spiel der Vorrichtung steht zur Wahl (testdaten/assistent)
bis !!document.querySelector('fieldset input[type=radio][value="wahlspiel"]')
bis document.querySelectorAll('ol[aria-label="Schritte zum neuen Set"] li').length === 3
pruefe (window.__aktuell = () => document.querySelector('ol[aria-label="Schritte zum neuen Set"] li[aria-current="step"]').lastChild.textContent, window.__sichtbar = () => [...document.querySelectorAll('fieldset input[type=radio]')].map((r) => r.value), window.__gewaehlt = () => [...document.querySelectorAll('fieldset input[type=radio]')].filter((r) => r.checked).map((r) => r.value).join(), window.__knopf = (text) => { document.querySelectorAll('[data-ziel]').forEach((x) => { delete x.dataset.ziel }); const kopf = [...document.querySelectorAll('h2')].find((h) => h.textContent === 'Ein neues Set'); const knopf = [...kopf.closest('section').querySelectorAll('button')].find((b) => b.innerText.trim() === text); knopf.dataset.ziel = 'knopf'; return true }, true)
notiz Schritt 1 von 3 — jedes nutzbare Spiel beim Namen, mit der Zahl seiner Stile, das Wahlspiel vorgewählt
gleich window.__aktuell() => Art
zeige [...document.querySelectorAll('fieldset label')].map((l) => l.innerText.replace(/\s+/g, ' ').trim()).join(' | ')
gleich window.__gewaehlt() => wahlspiel
