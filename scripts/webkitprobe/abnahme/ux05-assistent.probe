bis window.__aktuell() === 'Aussehen'
gleich document.activeElement.tagName + ' ' + document.activeElement.textContent => H3 Aussehen
# **Die Stilwahl ist eine Suchauswahl** (`bausteine/Stilauswahl.tsx`): ein
# Feld mit Liste, jede Zeile »Name Kennung«, gesucht wird über beides
# (`passtZu` in `bausteine/suchwahl.ts`). Bis zum 2026-10-06 zählte diese
# Probe Radioknöpfe, die es seit der Umstellung nicht mehr gibt (WK04, #2105).
pruefe (window.__stilfeld = () => [...document.querySelectorAll('input[role=combobox]')].find((e) => e.checkVisibility() && e.labels?.[0]?.textContent === 'Stil des neuen Sets'), window.__zeilen = () => [...document.querySelectorAll('[role=option]')].filter((o) => o.checkVisibility()).map((o) => o.innerText.replace(/\s+/g, ' ').trim()), window.__stilfeldZiel = () => { document.querySelectorAll('[data-ziel]').forEach((x) => { delete x.dataset.ziel }); window.__stilfeld().dataset.ziel = 'stilfeld'; return true }, !!window.__stilfeld())
