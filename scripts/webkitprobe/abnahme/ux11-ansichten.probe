# UX-11 (#1683) — Sets, Decks und Sammlung als Liste, Kacheln oder Galerie: umschalten, suchen, und nach einem Neuladen steht dieselbe Ansicht da.
#
# **Gesetzt wie ein Mensch es setzt**: über den Umschalter der Liste, und
# gemerkt über dieselbe Einstellung, die der Bestand schreibt
# (`arbeitsplatz.ansicht.*`). **Neu geladen wird die ganze Seite** — erst
# dann zeigt sich, ob die Ansicht gemerkt ist oder nur im Speicher stand.
#
# **Was es nicht zeigt**: einen Bestand mit hunderten Sets — das seitenweise
# Laden prüft `listenansicht.test.tsx` mit 61 Einträgen. **Am Ende wird
# zurückgesetzt**: die Drehbücher danach laufen auf demselben Bestand.
motor wk2
lade /
frist 20000
warte nav
wartetext Erste Schritte
taste escape
pruefe (window.__form = () => { const l = [...document.querySelectorAll('ul[data-form]')].find((x) => x.checkVisibility()); return l ? l.dataset.form : 'keine' }, window.__knopf = (text) => { document.querySelectorAll('[data-ziel="ziel"]').forEach((x) => delete x.dataset.ziel); const b = [...document.querySelectorAll('main button, main [role=radiogroup] label')].find((k) => k.checkVisibility() && k.textContent.trim() === text); if (b) b.dataset.ziel = 'ziel'; return b !== undefined }, window.__waehle = (text, wert) => { const s = [...document.querySelectorAll('select')].find((w) => w.checkVisibility() && w.labels && w.labels[0] && w.labels[0].textContent.includes(text)); if (s && s.value !== wert) { s.value = wert; s.dispatchEvent(new Event('change', { bubbles: true })) } return s !== undefined }, true)

notiz Sets — Kacheln sind die Vorgabe, die Liste wird gemerkt
# **Seit AP-6 (#2363) ist die Ansicht ein Segment** — eine Optionsgruppe mit
# einer Tabstelle; `__knopf` nimmt deshalb auch ihre Beschriftungen.
